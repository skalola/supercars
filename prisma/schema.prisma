model MarketSource {
  id        String   @id @default(uuid())
  /// Type of source: AUCTION | DEALER | MARKETPLACE
  name      String   @unique
  type      String
  website   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings            Listing[]
  sales               MarketSale[]
  vinDiscoverySources VinDiscoverySource[]
  partnerContact      PartnerContact?
}

model Listing {
  id                String   @id @default(uuid())
  modelId           String
  sourceId          String?
  externalListingId String?
  year              Int
  price             Float?
  mileage           Int?
  color             String?
  location          String?
  dealerName        String?
  url               String?
  imageUrl          String?
  vinVerified       Boolean  @default(false)
  validationStatus  String   @default("VALID")
  /// Status: ACTIVE | SOLD | REMOVED
  status            String   @default("ACTIVE")
  firstSeen         DateTime @default(now())
  lastSeen          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  model  Model         @relation(fields: [modelId], references: [id])
  source MarketSource? @relation(fields: [sourceId], references: [id])

  // Local marketplace fields
  vehicleId   String?
  sellerId    String?
  askingPrice Float?

  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  seller              User?                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  purchases           Purchase[]
  fulfillmentRequests FulfillmentRequest[]

  priceStatus      String? @default("VALID_PRICE")
  freshnessStatus  String? @default("ACTIVE")
  sourceConfidence String? @default("MEDIUM")

  @@unique([sourceId, externalListingId])
  @@index([sourceId, url])
  @@index([status, validationStatus, modelId])
  @@index([vehicleId, status])
  @@index([modelId, firstSeen])
}

