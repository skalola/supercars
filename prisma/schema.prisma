generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Make {
  id                         String                      @id @default(uuid())
  name                       String                      @unique
  slug                       String                      @unique
  logoUrl                    String?
  region                     String?
  models                     Model[]
  partCompatibility          PartCompatibility[]
  partCatalogReferences      PartCatalogReference[]
  preferredPartBrands        PreferredPartBrand[]
  partsMarqueConfig          PartsMarqueConfig?
  partApplicabilityOverrides PartApplicabilityOverride[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

model Model {
  id                  String    @id @default(uuid())
  makeId              String
  name                String
  slug                String
  years               String?
  productionStartYear Int?
  productionEndYear   Int?
  category            String?
  bodyStyle           String?
  productionCount     Int?
  description         String?
  metadataStatus      String    @default("UNREVIEWED")
  metadataConfidence  Float?
  metadataSource      String?
  metadataSourceUrl   String?
  lastMetadataAuditAt DateTime?

  make                          Make                           @relation(fields: [makeId], references: [id])
  vehicles                      Vehicle[]
  spec                          ModelSpec?
  images                        ModelImage[]
  imageCandidates               ModelImageCandidate[]
  variants                      ModelVariant[]
  garageItems                   GarageItem[]
  carClubs                      CarClubModel[]
  maintenanceRules              MaintenanceRule[]
  listings                      Listing[]
  marketSales                   MarketSale[]
  marketSnapshots               MarketSnapshot[]
  marketSummary                 MarketModelSummary?
  partCompatibility             PartCompatibility[]
  partComponents                ModelPartComponent[]
  partCatalogReferences         PartCatalogReference[]
  partPerformanceConfigurations PartPerformanceConfiguration[]
  preferredPartBrands           PreferredPartBrand[]
  partApplicabilityOverrides    PartApplicabilityOverride[]
  engineeringProfiles           ModelEngineeringProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([makeId, slug])
}

model ModelSpec {
  id           String  @id @default(uuid())
  modelId      String  @unique
  engine       String?
  displacement String?
  cylinders    String?
  horsepower   String?
  torque       String?
  transmission String?
  drivetrain   String?
  topSpeed     String?
  zeroToSixty  String?
  weight       String?

  model Model @relation(fields: [modelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModelVariant {
  id                  String  @id @default(uuid())
  modelId             String
  name                String
  slug                String
  productionStartYear Int?
  productionEndYear   Int?
  productionCount     Int?
  description         String?

  model Model @relation(fields: [modelId], references: [id])

  partCompatibility             PartCompatibility[]
  partApplicability             ModelPartApplicability[]
  partCatalogReferences         PartCatalogReference[]
  partPerformanceConfigurations PartPerformanceConfiguration[]
  engineeringProfiles           ModelEngineeringProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modelId, slug])
}

model ModelEngineeringProfile {
  id                      String  @id @default(uuid())
  profileKey              String  @unique
  modelId                 String
  variantId               String?
  scope                   String  @default("MODEL")
  yearStart               Int?
  yearEnd                 Int?
  engineCode              String?
  engineDescription       String?
  aspiration              String  @default("UNKNOWN")
  drivetrain              String  @default("UNKNOWN")
  transmissionType        String  @default("UNKNOWN")
  transmissionDescription String?
  horsepower              Int?
  torqueLbFt              Int?
  weightLb                Int?
  frontTireWidthMm        Int?
  rearTireWidthMm         Int?
  frontWheelDiameterIn    Int?
  rearWheelDiameterIn     Int?
  tireCompound            String?
  tireLoadRating          String?
  frontRotorDiameterMm    Int?
  rearRotorDiameterMm     Int?
  frontBrakePistonCount   Int?
  rearBrakePistonCount    Int?
  brakeRotorMaterial      String?
  oilCooling              String?
  chargeCooling           String?
  transmissionCooling     String?
  brakeCooling            String?
  sustainedUseRating      String  @default("UNKNOWN")
  confidence              String  @default("UNKNOWN")
  reviewStatus            String  @default("NEEDS_REVIEW")

  model    Model                      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  variant  ModelVariant?              @relation(fields: [variantId], references: [id], onDelete: Cascade)
  evidence ModelEngineeringEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modelId, scope])
  @@index([variantId])
  @@index([reviewStatus, confidence])
}

model ModelEngineeringEvidence {
  id          String   @id @default(uuid())
  evidenceKey String   @unique
  profileId   String
  fieldName   String
  sourceType  String
  sourceName  String
  sourceUrl   String?
  rawValue    String?
  confidence  String   @default("UNKNOWN")
  notes       String?
  capturedAt  DateTime @default(now())

  profile ModelEngineeringProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, fieldName])
  @@index([sourceType, confidence])
}

model ModelImage {
  id             String  @id @default(uuid())
  modelId        String
  url            String
  source         String?
  type           String?
  sourceUrl      String?
  sourceName     String?
  license        String?
  attribution    String?
  attributionUrl String?
  confidence     Float?
  reviewStatus   String  @default("UNREVIEWED")

  model Model @relation(fields: [modelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modelId, url])
}

model ModelImageCandidate {
  id             String  @id @default(uuid())
  modelId        String?
  makeId         String?
  makeName       String
  modelName      String?
  baseModelName  String?
  url            String
  source         String
  sourceName     String?
  sourceUrl      String?
  license        String?
  attribution    String?
  attributionUrl String?
  title          String?
  category       String?
  context        String?
  confidence     Float?
  reviewStatus   String  @default("UNREVIEWED")
  matchedModelId String?

  model Model? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, url, makeName])
  @@index([makeName])
  @@index([baseModelName])
  @@index([matchedModelId])
}

model Vehicle {
  id      String @id @default(uuid())
  vin     String @unique
  modelId String
  year    Int

  // Identity
  trim              String?
  series            String?
  manufacturer      String?
  destinationMarket String?

  // Details
  color       String?
  mileage     Int?
  bodyStyle   String?
  vehicleType String?
  doors       String?
  fuelType    String?

  // Engine & Performance
  engine              String?
  engineConfiguration String?
  engineCylinders     String?
  displacement        String?
  turbo               String?
  transmission        String?
  transmissionSpeeds  String?
  drivetrain          String?
  engineHP            String?
  engineKW            String?
  engineManufacturer  String?

  // Manufacturing
  plantCountry String?
  plantCity    String?
  plantState   String?

  // Safety
  abs                  String?
  esc                  String?
  tpms                 String?
  rearVisibilitySystem String?
  parkAssist           String?
  adaptiveDrivingBeam  String?
  airBagLocFront       String?
  airBagLocKnee        String?
  airBagLocSide        String?
  pretensioner         String?
  seatBeltsAll         String?

  // Others
  gvwr                 String?
  brakeSystem          String?
  electrificationLevel String?

  status  String  @default("UNCLAIMED")
  ownerId String?

  model                  Model                  @relation(fields: [modelId], references: [id])
  owner                  User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  images                 VehicleImage[]
  profile                VehicleProfile?
  modifications          VehicleModification[]
  installedParts         VehicleInstalledPart[]
  serviceRecords         ServiceRecord[]
  awards                 VehicleAward[]
  photos                 VehiclePhoto[]
  documents              VehicleDocument[]
  listings               Listing[]
  vinDiscovery           VinDiscovery?
  insuranceRequests      InsuranceRequest[]
  deliveryRequests       DeliveryRequest[]
  fulfillmentRequests    FulfillmentRequest[]
  trackerAlertDeliveries TrackerAlertDelivery[]
  meetRsvps              MeetRsvp[]
  meetPhotos             MeetPhoto[]
  partAffiliateClicks    PartAffiliateClick[]

  mileageStatus             String? @default("COMPLETE")
  vinIdentityStatus         String? @default("VALID")
  vinIdentityClassification String? // VALID | MODEL_NAMING_VARIATION | TRIM_VARIATION | TRUE_IDENTITY_CONFLICT | YEAR_CONFLICT | MAKE_CONFLICT
  imageValidationStatus     String? @default("VALID_IMAGE")
  inventoryStatus           String? @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleImage {
  id               String   @id @default(uuid())
  vehicleId        String
  url              String
  alt              String?
  isPrimary        Boolean  @default(false)
  validationStatus String   @default("VALID")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, validationStatus])
  @@index([vehicleId, isPrimary])
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String?   @default("USER")

  accounts               Account[]
  sessions               Session[]
  trackerPreference      UserTrackerPreference?
  trackerAlertDeliveries TrackerAlertDelivery[]
  garageItems            GarageItem[]
  vehicles               Vehicle[]
  listings               Listing[]
  purchases              Purchase[]
  insuranceRequests      InsuranceRequest[]
  deliveryRequests       DeliveryRequest[]
  fulfillmentRequests    FulfillmentRequest[]
  hostedMeets            Meet[]
  meetRsvps              MeetRsvp[]
  meetPhotos             MeetPhoto[]
  meetNotifications      MeetNotification[]
  createdCarClubs        CarClub[]              @relation("CarClubCreator")
  carClubMemberships     CarClubMember[]
  vehicleInstalledParts  VehicleInstalledPart[]
  partAffiliateClicks    PartAffiliateClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserTrackerPreference {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  listingTrackerEnabled     Boolean  @default(false)
  priceTrackerEnabled       Boolean  @default(false)
  maintenanceTrackerEnabled Boolean  @default(false)
  eventsTrackerEnabled      Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActionRateLimit {
  id          String   @id @default(uuid())
  actorKey    String
  action      String
  bucketKey   String   @default("GLOBAL")
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([actorKey, action, bucketKey, windowStart])
  @@index([expiresAt])
  @@index([actorKey, action])
}

model TrackerAlertDelivery {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String?
  modelId   String?
  alertType String
  alertKey  String
  sentAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, alertType, alertKey])
  @@index([vehicleId, alertType])
  @@index([modelId, alertType])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GarageItem {
  id                          String    @id @default(cuid())
  userId                      String
  modelId                     String
  priceTrackerAlertsEnabled   Boolean   @default(false)
  listingTrackerAlertsEnabled Boolean   @default(false)
  priceTrackerBaseline        Float?
  lastPriceAlertAt            DateTime?
  lastListingAlertAt          DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([modelId, priceTrackerAlertsEnabled])
  @@index([modelId, listingTrackerAlertsEnabled])
}

// ──────────────────────────────────────────────
// SUPERCAR DASH Meets
// ──────────────────────────────────────────────

model Meet {
  id             String    @id @default(uuid())
  slug           String    @unique
  hostId         String
  clubId         String?
  title          String
  type           String
  /// Status: DRAFT | PUBLISHED | FULL | CANCELLED | COMPLETED | HIDDEN
  status         String    @default("DRAFT")
  /// Visibility: PUBLIC | INVITE_ONLY
  visibility     String    @default("PUBLIC")
  startsAt       DateTime
  endsAt         DateTime?
  city           String
  state          String
  locationName   String
  locationDetail String?
  exactAddress   String?
  latitude       Float?
  longitude      Float?
  mapX           Float?
  mapY           Float?
  capacity       Int?
  description    String?
  allowedMakes   String    @default("[]")
  heroImageUrl   String?
  publishedAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  host          User               @relation(fields: [hostId], references: [id], onDelete: Cascade)
  club          CarClub?           @relation(fields: [clubId], references: [id], onDelete: SetNull)
  rsvps         MeetRsvp[]
  photos        MeetPhoto[]
  notifications MeetNotification[]

  @@index([status, startsAt])
  @@index([city, state])
  @@index([hostId, startsAt])
  @@index([clubId, startsAt])
}

model CarClub {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  city        String?
  state       String?
  country     String?  @default("US")
  visibility  String   @default("PUBLIC")
  status      String   @default("ACTIVE")
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User            @relation("CarClubCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members CarClubMember[]
  models  CarClubModel[]
  meets   Meet[]

  @@index([creatorId])
  @@index([city, state])
  @@index([status, visibility])
}

model CarClubMember {
  id        String    @id @default(uuid())
  clubId    String
  userId    String
  role      String    @default("MEMBER")
  status    String    @default("PENDING")
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  club CarClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId, status])
  @@index([userId, status])
}

model CarClubModel {
  id        String   @id @default(uuid())
  clubId    String
  modelId   String
  createdAt DateTime @default(now())

  club  CarClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  model Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([clubId, modelId])
  @@index([modelId])
}

model MeetRsvp {
  id        String   @id @default(uuid())
  meetId    String
  userId    String
  vehicleId String?
  /// Status: GOING | MAYBE | WAITLISTED | CANCELLED
  status    String   @default("GOING")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meet    Meet     @relation(fields: [meetId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([meetId, userId])
  @@index([userId, status])
  @@index([vehicleId])
}

model MeetPhoto {
  id        String   @id @default(uuid())
  meetId    String
  userId    String?
  vehicleId String?
  url       String
  caption   String?
  createdAt DateTime @default(now())

  meet    Meet     @relation(fields: [meetId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([meetId])
  @@index([vehicleId])
}

model MeetNotification {
  id                String   @id @default(uuid())
  meetId            String
  userId            String?
  notificationType  String
  recipientEmail    String?
  status            String   @default("PENDING")
  provider          String?
  providerMessageId String?
  subject           String?
  reason            String?
  createdAt         DateTime @default(now())

  meet Meet  @relation(fields: [meetId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetId, notificationType])
  @@index([userId, notificationType])
  @@index([status, createdAt])
}

model VehicleProfile {
  id             String   @id @default(uuid())
  vehicleId      String   @unique
  exteriorColor  String?
  interiorColor  String?
  currentMileage Int?
  ownerNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model VehicleModification {
  id            String   @id @default(uuid())
  vehicleId     String
  name          String
  brand         String?
  description   String?
  installedDate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle        Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  catalogInstall VehicleInstalledPart?

  @@index([vehicleId])
}

// ──────────────────────────────────────────────
// Parts Catalog Foundation
// ──────────────────────────────────────────────

model PartCategory {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  parts           PerformancePart[]
  installedParts  VehicleInstalledPart[]
  catalogNodes    PartCatalogNode[]
  componentTypes  PartComponentType[]
  preferredBrands PreferredPartBrand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
}

model PartCatalogNode {
  id              String  @id @default(uuid())
  categoryId      String?
  parentId        String?
  name            String
  slug            String
  path            String  @unique
  description     String?
  iconUrl         String?
  depth           Int     @default(0)
  displayOrder    Int     @default(0)
  sourceName      String?
  sourceUrl       String?
  placeholderOnly Boolean @default(true)
  inventoryStatus String  @default("SHELL_ONLY")
  active          Boolean @default(true)

  category PartCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parent   PartCatalogNode?  @relation("PartCatalogTree", fields: [parentId], references: [id], onDelete: Cascade)
  children PartCatalogNode[] @relation("PartCatalogTree")
  parts    PerformancePart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, active])
  @@index([parentId, displayOrder])
  @@index([inventoryStatus])
}

model PartBrand {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  logoUrl         String?
  logoSourceUrl   String?
  logoBackground  String    @default("UNKNOWN")
  logoVerifiedAt  DateTime?
  logoNeedsReview Boolean   @default(false)
  websiteUrl      String?
  country         String?
  brandType       String    @default("OTHER")
  qualityWeight   Int       @default(50)
  description     String?
  active          Boolean   @default(true)

  parts             PerformancePart[]
  preferredMappings PreferredPartBrand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, name])
}

model AffiliatePartner {
  id               String  @id @default(uuid())
  name             String
  slug             String  @unique
  network          String?
  websiteUrl       String?
  status           String  @default("INACTIVE")
  commissionLabel  String?
  trackingTemplate String?
  disclosure       String?
  active           Boolean @default(false)

  parts          PerformancePart[]
  offers         PartOffer[]
  clicks         PartAffiliateClick[]
  offerProviders PartOfferProvider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, active])
}

model PartOfferProvider {
  id                 String  @id @default(uuid())
  code               String  @unique
  name               String
  providerType       String
  adapterKey         String?
  websiteUrl         String?
  affiliatePartnerId String?
  active             Boolean @default(false)

  affiliatePartner AffiliatePartner?    @relation(fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  offers           PartOffer[]
  preferredBrands  PreferredPartBrand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerType, active])
  @@index([affiliatePartnerId])
}

model PreferredPartBrand {
  id                  String  @id @default(uuid())
  scopeKey            String  @unique
  vehicleMakeId       String
  vehicleModelId      String?
  partBrandId         String
  componentCategoryId String?
  componentTypeId     String?
  offerProviderId     String?
  relationshipType    String
  priority            Int     @default(100)
  officialCatalogUrl  String?
  affiliateEnabled    Boolean @default(false)
  affiliateStatus     String  @default("NOT_CONTACTED")
  trackingConfigName  String?
  active              Boolean @default(true)

  vehicleMake       Make               @relation(fields: [vehicleMakeId], references: [id], onDelete: Cascade)
  vehicleModel      Model?             @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  partBrand         PartBrand          @relation(fields: [partBrandId], references: [id], onDelete: Cascade)
  componentCategory PartCategory?      @relation(fields: [componentCategoryId], references: [id], onDelete: Cascade)
  componentType     PartComponentType? @relation(fields: [componentTypeId], references: [id], onDelete: Cascade)
  offerProvider     PartOfferProvider? @relation(fields: [offerProviderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleMakeId, active, priority])
  @@index([vehicleModelId, active, priority])
  @@index([vehicleMakeId, componentCategoryId, active, priority])
  @@index([vehicleMakeId, componentTypeId, active, priority])
  @@index([partBrandId, affiliateStatus])
  @@index([offerProviderId, active])
}

model PerformancePart {
  id                 String  @id @default(uuid())
  categoryId         String
  catalogNodeId      String?
  componentTypeId    String?
  brandId            String
  affiliatePartnerId String?
  name               String
  slug               String
  partNumber         String?
  oemPartNumber      String?
  canonicalKey       String? @unique
  componentType      String?
  description        String?
  imageUrl           String?
  sourceUrl          String?
  sourceName         String?
  sourceCatalog      String?
  sourceCategory     String?
  diagramReference   String?
  sourceConfidence   String  @default("MANUAL_REVIEW")
  status             String  @default("DRAFT")

  /// Legacy catalog reference price. Current purchasable prices belong to PartOffer.
  retailPriceCents  Int?
  currency          String    @default("USD")
  /// Legacy direct-commerce fields. New providers must create PartOffer records.
  retailerName      String?
  retailerSku       String?
  affiliateUrl      String?
  commissionRateBps Int?
  trackingStatus    String    @default("NOT_CONFIGURED")
  lastCheckedAt     DateTime?

  estimatedHpGain     Int?
  estimatedTorqueGain Int?
  gainBasis           String?
  installComplexity   String?
  notes               String?
  normalizedTitle     String?
  productFamilyType   String  @default("CANONICAL")
  partType            String  @default("UNCLASSIFIED")
  identityConfidence  String  @default("UNVERIFIED")
  identityKey         String? @unique
  catalogPublished    Boolean @default(false)
  offerGapStatus      String  @default("UNASSESSED")
  material            String?
  replacementType     String?

  category                  PartCategory                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  catalogNode               PartCatalogNode?               @relation(fields: [catalogNodeId], references: [id], onDelete: SetNull)
  canonicalComponent        PartComponentType?             @relation(fields: [componentTypeId], references: [id], onDelete: SetNull)
  brand                     PartBrand                      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  affiliatePartner          AffiliatePartner?              @relation(fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
