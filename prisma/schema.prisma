  updatedAt DateTime @updatedAt

  @@unique([brandId, slug])
  @@index([categoryId, status])
  @@index([catalogNodeId, status])
  @@index([componentTypeId, status])
  @@index([brandId, status])
  @@index([oemPartNumber])
  @@index([sourceCatalog, status])
  @@index([trackingStatus])
  @@index([status, lastCheckedAt])
  @@index([catalogPublished, identityConfidence, status])
  @@index([componentTypeId, partType, catalogPublished])
  @@index([offerGapStatus, status])
