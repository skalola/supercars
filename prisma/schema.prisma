  source    MarketSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([discoveryId, sourceKey])
  @@index([sourceName, active])
  @@index([discoveryId, active])
}

model MarketSale {
  id        String   @id @default(uuid())
  modelId   String
  sourceId  String
  saleDate  DateTime
  salePrice Float
  year      Int
  mileage   Int?
  color     String?
  location  String?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model  Model        @relation(fields: [modelId], references: [id])
  source MarketSource @relation(fields: [sourceId], references: [id])

  @@index([modelId, saleDate])
  @@index([sourceId, url])
  @@index([modelId, sourceId, saleDate, salePrice])
}

model MarketSnapshot {
  id                 String   @id @default(uuid())
  modelId            String
  date               DateTime
  activeListingCount Int      @default(0)
  averagePrice       Float?
  medianPrice        Float?
  lowestPrice        Float?
  highestPrice       Float?
  salesCount         Int      @default(0)
  averageMileage     Float?
  createdAt          DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id])

  @@unique([modelId, date])
}

model MarketModelSummary {
  modelId                   String    @id
  activeListingCount        Int       @default(0)
  lowestListingPrice        Float?
  highestListingPrice       Float?
  averageAskingPrice        Float?
  medianAskingPrice         Float?
  totalActiveInventoryValue Float     @default(0)
  recentSalesCount          Int       @default(0)
  averageSalePrice          Float?
  medianSalePrice           Float?
  averageSaleMileage        Float?
  averageSoldPrice          Float?
  askingVsSoldDifference    Float?
  askingVsSoldDifferencePct Float?
  trendDirection            String?
  trendChangePercent        Float?
  trendSnapshotCount        Int       @default(0)
  lastListingSeenAt         DateTime?
  lastSaleSeenAt            DateTime?
  refreshedAt               DateTime  @default(now())
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([activeListingCount])
  @@index([refreshedAt])
}

model Purchase {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  amount    Decimal  @db.Decimal(14, 2)
  status    String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing             Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer               User                 @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  insuranceRequest    InsuranceRequest?
  deliveryRequest     DeliveryRequest?
  fulfillmentRequests FulfillmentRequest[]
}

model InsuranceRequest {
  id         String   @id @default(uuid())
  purchaseId String   @unique
  userId     String
  vehicleId  String
  status     String   @default("NOT_STARTED") // NOT_STARTED, REQUESTED, QUOTE_STARTED, COMPLETED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model DeliveryRequest {
  id              String   @id @default(uuid())
  purchaseId      String   @unique
  userId          String
  vehicleId       String
  status          String   @default("NOT_STARTED") // NOT_STARTED, REQUESTED, SCHEDULED, IN_TRANSIT, DELIVERED
  street          String
  city            String
  state           String
  postalCode      String
  deliveryDate    String?
  transportMethod String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Sprint 7.0: Fulfillment Core Infrastructure
// ──────────────────────────────────────────────

model FulfillmentRequest {
  id                     String @id @default(uuid())
  /// Type: DEALER_PURCHASE | INSURANCE_QUOTE | TRANSPORT_QUOTE | SERVICE_BOOKING
  requestType            String
  /// Status: DRAFT | READY_TO_SEND | SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED | CANCELLED | COMPLETED
  status                 String @default("DRAFT")
  publicTransactionToken String @unique @default(uuid())

  /// Payment Status: NOT_REQUIRED | AUTHORIZATION_PENDING | AUTHORIZED | CAPTURE_PENDING | CAPTURED | REFUNDED | VOIDED | FAILED | CANCELLED
  paymentStatus             String    @default("NOT_REQUIRED")
  cancellationReason        String?
  cancelledByActor          String?
  expectedPlatformFee       Decimal   @default(0) @db.Decimal(14, 2)
  expectedPartnerCommission Decimal   @default(0) @db.Decimal(14, 2)
  collectedAmount           Decimal   @default(0) @db.Decimal(14, 2)
  refundableAmount          Decimal   @default(0) @db.Decimal(14, 2)
  partnerAcceptedAt         DateTime?
  completedAt               DateTime?
  /// Payout Status: UNSETTLED | PENDING_RECONCILIATION | RECONCILED | PAYOUT_COMPLETED
  payoutStatus              String    @default("UNSETTLED")

  buyerId    String?
  vehicleId  String?
  listingId  String?
  purchaseId String?
  notes      String?

  buyer    User?     @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  parties        FulfillmentParty[]
  packages       FulfillmentPackage[]
  events         FulfillmentEvent[]
  fees           FulfillmentFee[]
  depositIntents DepositIntent[]
  partnerTokens  PartnerDecisionToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestType, status])
  @@index([publicTransactionToken])
}

model FulfillmentParty {
  id                   String  @id @default(uuid())
  fulfillmentRequestId String
  /// Type: BUYER | SELLER | DEALER | INSURANCE_CARRIER | TRANSPORT_PROVIDER | SERVICE_CENTER | PLATFORM
  partyType            String
  userId               String?
  name                 String
  email                String?
  phone                String?
  companyName          String?
  address              String?
  roleDescription      String?
  partnerContactId     String?

  fulfillmentRequest FulfillmentRequest @relation(fields: [fulfillmentRequestId], references: [id], onDelete: Cascade)
  partnerContact     PartnerContact?    @relation(fields: [partnerContactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentRequestId])
}

model FulfillmentPackage {
  id                   String  @id @default(uuid())
  fulfillmentRequestId String
  title                String
  description          String?
  /// JSON-encoded string holding the scoped partner data package
  scope                String

  fulfillmentRequest FulfillmentRequest @relation(fields: [fulfillmentRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentRequestId])
}

model FulfillmentEvent {
  id                   String  @id @default(uuid())
  fulfillmentRequestId String
  previousStatus       String?
  newStatus            String
  /// ActorType: BUYER | PARTNER | SYSTEM | ADMIN
  actorType            String  @default("SYSTEM")
  actorId              String?
  note                 String?
  metadata             String?

  fulfillmentRequest FulfillmentRequest @relation(fields: [fulfillmentRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([fulfillmentRequestId])
}

model FulfillmentFee {
  id                   String  @id @default(uuid())
  fulfillmentRequestId String
  /// FeeType: COMMISSION | SERVICE_FEE | TRANSPORT_FEE | REFERRAL_FEE | DEPOSIT
  feeType              String
  amount               Decimal @db.Decimal(14, 2)
  currency             String  @default("USD")
  /// Status: ESTIMATED | AUTHORIZED | CAPTURED | REFUNDED | WAIVED
  status               String  @default("ESTIMATED")
  description          String?

  fulfillmentRequest FulfillmentRequest @relation(fields: [fulfillmentRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentRequestId])
}

model DepositIntent {
  id                   String    @id @default(uuid())
  fulfillmentRequestId String
  amount               Decimal   @db.Decimal(14, 2)
  currency             String    @default("USD")
  /// Status: AUTHORIZED | HELD | CAPTURED | RELEASED | REFUNDED
  status               String    @default("AUTHORIZED")
  paymentMethod        String?
  transactionRef       String?
  checkoutKey          String?   @unique
  checkoutSessionId    String?   @unique
  checkoutUrl          String?
  checkoutExpiresAt    DateTime?
  expiresAt            DateTime?
  capturedAt           DateTime?
  releasedAt           DateTime?

  fulfillmentRequest FulfillmentRequest @relation(fields: [fulfillmentRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentRequestId])
}

model PaymentWebhookEvent {
  id                   String    @id @default(uuid())
  provider             String
  eventId              String
  eventType            String
  /// Status: PROCESSING | PROCESSED | FAILED
  status               String    @default("PROCESSING")
  attempts             Int       @default(1)
  fulfillmentRequestId String?
  errorMessage         String?
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?
  updatedAt            DateTime  @updatedAt

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([fulfillmentRequestId])
}

model PartnerDecisionToken {
  id                   String    @id @default(uuid())
  fulfillmentRequestId String
  token                String    @unique @default(uuid())
  partnerPartyId       String?
  partnerName          String?
  partnerEmail         String?
  expiresAt            DateTime?
  viewedAt             DateTime?
  actionTakenAt        DateTime?
  /// Action: ACCEPTED | DECLINED | EXPIRED
  actionTaken          String?

  fulfillmentRequest FulfillmentRequest @relation(fields: [fulfillmentRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([fulfillmentRequestId])
  @@index([actionTaken, expiresAt])
}

// ──────────────────────────────────────────────
// Sprint 7.2: Partner Contact Registry
// ──────────────────────────────────────────────

model PartnerContact {
  id                 String    @id @default(uuid())
  name               String
  /// Type: DEALER | INSURER | TRANSPORTER | SERVICE_SHOP
  type               String
  email              String?
  phone              String?
  website            String?
  sourceDomain       String?
  makeSpecialization String?   @default("ALL") // Ferrari | Lamborghini | ALL
  location           String?
  streetAddress      String?
  city               String?
  state              String?
  postalCode         String?
  country            String?   @default("US")
  latitude           Float?
  longitude          Float?
  active             Boolean   @default(true)
  /// ContactSource: IMPORTED_LISTING | PUBLIC_WEBSITE | MANUALLY_VERIFIED
  contactSource      String    @default("PUBLIC_WEBSITE")
  /// Confidence: VERIFIED | PUBLIC_SOURCE | MANUAL_REVIEW | UNRESOLVED_EMAIL
  confidence         String    @default("PUBLIC_SOURCE")
  /// ContactStatus: RESOLVED | UNRESOLVED_EMAIL
  contactStatus      String    @default("RESOLVED")
  coverage           String    @default("LOCAL") // LOCAL | NATIONAL
  lastVerifiedAt     DateTime?

  marketSourceId String?       @unique
  marketSource   MarketSource? @relation(fields: [marketSourceId], references: [id], onDelete: SetNull)

  fulfillmentParties FulfillmentParty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([type, makeSpecialization])
  @@index([state, city])
  @@index([latitude, longitude])
  @@index([contactStatus])
}

// ──────────────────────────────────────────────
// Admin Global Settings
// ──────────────────────────────────────────────

model GlobalSetting {
  key         String               @id
  label       String
  description String?
  enabled     Boolean              @default(false)
  category    String               @default("GENERAL")
  updatedBy   String?
  audits      GlobalSettingAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model GlobalSettingAudit {
  id            String   @id @default(uuid())
  settingKey    String
  previousValue Boolean?
  newValue      Boolean
  actor         String?
  note          String?

  setting GlobalSetting @relation(fields: [settingKey], references: [key], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([settingKey])
  @@index([createdAt])
}
